android_app {
    name: "ZephyrParts",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,
    static_libs: ["SettingsLib"],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
